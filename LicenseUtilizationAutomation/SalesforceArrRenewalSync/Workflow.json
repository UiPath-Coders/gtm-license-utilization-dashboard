{
  "document": {
    "dsl": "1.0.0",
    "name": "Workflow",
    "tags": {
      "projectId": "arr-renewal-sync-project-id"
    },
    "version": "0.0.1",
    "namespace": "default",
    "metadata": {
      "variables": {
        "schema": {
          "format": "json",
          "document": {
            "type": "object",
            "title": "Variables",
            "properties": {
              "directoryRecords": { "type": "array", "default": [] },
              "renewalChunks": { "type": "array", "default": [] },
              "renewalByCustomerId": { "type": "object", "default": {} }
            }
          }
        }
      }
    }
  },
  "input": {
    "schema": {
      "format": "json",
      "document": { "type": "object", "properties": {}, "title": "Inputs" }
    }
  },
  "output": {
    "schema": {
      "format": "json",
      "document": { "type": "object", "properties": {}, "title": "Outputs" }
    }
  },
  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}) }",
              "output": { "as": "${$input}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Workflow start",
                "fullName": "Assign",
                "isTransparent": true
              }
            }
          },
          {
            "ListCustomerAccountDirectory_1": {
              "call": "UiPath.IntSvc",
              "with": {
                "connector": "uipath-uipath-dataservice",
                "connectionId": "811fa38a-025c-4259-a660-4d0ab299af33",
                "connectionResourceId": "811fa38a-025c-4259-a660-4d0ab299af33",
                "method": "GET",
                "endpoint": "/CustomerAccountDirectory",
                "queryParameters": { "limit": 1000 }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ListCustomerAccountDirectory_1\": $output } }" },
              "metadata": {
                "fullName": "Connector",
                "activityType": "Connector",
                "displayName": "List Customer Account Directory Records",
                "uiPathActivityTypeId": "b98b6a53-4d89-3ad8-ad76-8fff9f27ce51",
                "assemblyQualifiedName": "Connector",
                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"list\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CustomerAccountDirectory\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/CustomerAccountDirectory\",\"unifiedTypesCompatible\":true}}"
              }
            }
          },
          {
            "ParseDirectoryRecords": {
              "run": {
                "script": {
                  "code": "const out = $context.outputs.ListCustomerAccountDirectory_1; const raw = out && (out.content !== undefined ? out.content : out); const body = (typeof raw === 'string') ? JSON.parse(raw) : raw; const list = Array.isArray(body) ? body : ((body && (body.value || body.items)) || []); return list;",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ParseDirectoryRecords\": $output } }" },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Parse Directory Records",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Assign_SetDirectoryRecords": {
              "set": { "directoryRecords": "${$context.outputs.ParseDirectoryRecords}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Set Directory Records",
                "fullName": "Assign",
                "isTransparent": false
              }
            }
          },
          {
            "BuildRenewalChunks": {
              "run": {
                "script": {
                  "code": "const ids = ($context.variables.directoryRecords || []).map((r) => r.customerId).filter(Boolean); const chunkSize = 100; const chunks = []; for (let i = 0; i < ids.length; i += chunkSize) { const slice = ids.slice(i, i + chunkSize); const quoted = slice.map((id) => \"'\" + id + \"'\").join(','); chunks.push('Id in (' + quoted + ')'); } return chunks;",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"BuildRenewalChunks\": $output } }" },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Build Renewal Query Chunks",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Assign_SetRenewalChunks": {
              "set": { "renewalChunks": "${$context.outputs.BuildRenewalChunks}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Set Renewal Chunks",
                "fullName": "Assign",
                "isTransparent": false
              }
            }
          },
          {
            "For_Each_Renewal": {
              "for": {
                "each": "renewalChunk",
                "in": "${$context.variables.renewalChunks}",
                "at": "renewalChunkIndex"
              },
              "do": [
                {
                  "For_Each_Renewal#Body": {
                    "do": [
                      {
                        "ListAccount_Renewal": {
                          "call": "UiPath.IntSvc",
                          "with": {
                            "connector": "uipath-salesforce-sfdc",
                            "connectionId": "d8fda9b2-7a38-4fbc-910d-e49fbed0e4dd",
                            "connectionResourceId": "d8fda9b2-7a38-4fbc-910d-e49fbed0e4dd",
                            "method": "GET",
                            "endpoint": "/Account",
                            "queryParameters": {
                              "fields": "Id,Earliest_Renewal_Expiry_Date__c,Billed_ARR_YTD__c",
                              "pageSize": 200,
                              "where": "${$renewalChunk}"
                            }
                          },
                          "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ListAccount_Renewal\": $output } }" },
                          "metadata": {
                            "fullName": "Connector",
                            "activityType": "Connector",
                            "displayName": "List Accounts (Renewal + ARR)",
                            "uiPathActivityTypeId": "b98b6a53-4d89-3ad8-ad76-8fff9f27ce51",
                            "assemblyQualifiedName": "Connector",
                            "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-salesforce-sfdc\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"list\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"Account\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/Account\",\"unifiedTypesCompatible\":true}}"
                          }
                        }
                      }
                    ],
                    "export": {
                      "as": "{ ...$context, outputs: { ...$context?.outputs, \"For_Each_Renewal\": { ...$context?.outputs?.For_Each_Renewal, results: [ ...($renewalChunkIndex == 0 ? [] : ($context?.outputs?.For_Each_Renewal?.results ?? [])), ...([$output] ?? []) ] } } }"
                    }
                  }
                }
              ],
              "output": { "as": "${$context.outputs.For_Each_Renewal}" },
              "metadata": {
                "activityType": "ForEach",
                "displayName": "Fetch Renewal Dates + ARR",
                "fullName": "ForEach"
              }
            }
          },
          {
            "BuildRenewalMap": {
              "run": {
                "script": {
                  "code": "const results = ($context.outputs.For_Each_Renewal && $context.outputs.For_Each_Renewal.results) || []; const map = {}; results.forEach((r) => { const raw = r && (r.content !== undefined ? r.content : r); const body = (typeof raw === 'string') ? JSON.parse(raw) : raw; const list = Array.isArray(body) ? body : ((body && (body.value || body.items)) || []); list.forEach((rec) => { if (rec && rec.Id) { map[rec.Id] = { renewalDate: rec.Earliest_Renewal_Expiry_Date__c || null, arr: rec.Billed_ARR_YTD__c != null ? Number(rec.Billed_ARR_YTD__c) : null }; } }); }); return map;",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"BuildRenewalMap\": $output } }" },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Build Renewal/ARR Map",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Assign_SetRenewalMap": {
              "set": { "renewalByCustomerId": "${$context.outputs.BuildRenewalMap}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Set Renewal Map",
                "fullName": "Assign",
                "isTransparent": false
              }
            }
          },
          {
            "For_Each_Update": {
              "for": {
                "each": "currentItem",
                "in": "${$context.variables.directoryRecords}",
                "at": "currentItemIndex"
              },
              "do": [
                {
                  "For_Each_Update#Body": {
                    "do": [
                      {
                        "If_HasMatch#Wrapper": {
                          "do": [
                            {
                              "If_HasMatch": {
                                "switch": [
                                  {
                                    "case": {
                                      "when": "${$context.variables.renewalByCustomerId[$currentItem.customerId] !== undefined}",
                                      "then": "If_HasMatch#Then"
                                    }
                                  },
                                  { "default": { "then": "If_HasMatch#Else" } }
                                ],
                                "metadata": { "displayName": "Has Salesforce match?" }
                              }
                            },
                            {
                              "If_HasMatch#Then": {
                                "do": [
                                  {
                                    "UpdateDirectoryRecord_1": {
                                      "call": "UiPath.IntSvc",
                                      "with": {
                                        "connector": "uipath-uipath-dataservice",
                                        "connectionId": "811fa38a-025c-4259-a660-4d0ab299af33",
                                        "connectionResourceId": "811fa38a-025c-4259-a660-4d0ab299af33",
                                        "method": "PUT",
                                        "endpoint": "/CustomerAccountDirectory/{id}",
                                        "pathParameters": { "id": "${$currentItem.Id}" },
                                        "bodyParameters": {
                                          "customerId": "${$currentItem.customerId}",
                                          "customerName": "${$currentItem.customerName}",
                                          "accountOwnerName": "${$currentItem.accountOwnerName}",
                                          "customerGeo": "${$currentItem.customerGeo}",
                                          "customerArea": "${$currentItem.customerArea}",
                                          "customerRegion": "${$currentItem.customerRegion}",
                                          "activeCustomer": "${$currentItem.activeCustomer}",
                                          "csdName": "${$currentItem.csdName}",
                                          "tamName": "${$currentItem.tamName}",
                                          "customerSuccessManagerName": "${$currentItem.customerSuccessManagerName}",
                                          "parentCompanyName": "${$currentItem.parentCompanyName}",
                                          "lastSyncedAt": "${new Date().toISOString()}",
                                          "renewalDate": "${$context.variables.renewalByCustomerId[$currentItem.customerId].renewalDate}",
                                          "activeFinancialArr": "${$context.variables.renewalByCustomerId[$currentItem.customerId].arr}"
                                        }
                                      },
                                      "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"UpdateDirectoryRecord_1\": $output } }" },
                                      "metadata": {
                                        "fullName": "Connector",
                                        "activityType": "Connector",
                                        "displayName": "Update Directory Record (Renewal + ARR)",
                                        "uiPathActivityTypeId": "718fdc36-73a8-3607-8604-ddef95bb9967",
                                        "assemblyQualifiedName": "Connector",
                                        "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"replace\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CustomerAccountDirectory\",\"operation\":\"replace\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"PUT\",\"path\":\"/CustomerAccountDirectory/{id}\",\"unifiedTypesCompatible\":true}}"
                                      }
                                    }
                                  }
                                ],
                                "then": "exit"
                              }
                            },
                            {
                              "If_HasMatch#Else": {
                                "do": [],
                                "then": "exit"
                              }
                            }
                          ],
                          "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"If_HasMatch\": $output } }" },
                          "metadata": {
                            "activityType": "If",
                            "displayName": "Has Salesforce match?",
                            "fullName": "If"
                          }
                        }
                      }
                    ],
                    "export": {
                      "as": "{ ...$context, outputs: { ...$context?.outputs, \"For_Each_Update\": { ...$context?.outputs?.For_Each_Update, results: [ ...($currentItemIndex == 0 ? [] : ($context?.outputs?.For_Each_Update?.results ?? [])), ...([$output] ?? []) ] } } }"
                    }
                  }
                }
              ],
              "output": { "as": "${$context.outputs.For_Each_Update}" },
              "metadata": {
                "activityType": "ForEach",
                "displayName": "Update Each Account with Renewal + ARR",
                "fullName": "ForEach"
              }
            }
          },
          {
            "Response_1": {
              "response": "${{ accountsChecked: $context.variables.directoryRecords.length, status: 'success' }}",
              "markJobAsFailed": false,
              "then": "end",
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }" },
              "metadata": {
                "activityType": "Response",
                "displayName": "Response",
                "fullName": "Response"
              }
            }
          }
        ],
        "metadata": {
          "activityType": "Sequence",
          "displayName": "Sequence",
          "fullName": "Sequence"
        }
      }
    }
  ],
  "evaluate": {
    "mode": "strict",
    "language": "javascript"
  }
}
