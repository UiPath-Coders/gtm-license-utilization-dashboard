{
  "document": {
    "dsl": "1.0.0",
    "name": "Workflow",
    "tags": {
      "projectId": "bef155d0-6293-445e-be89-c5254c55d154"
    },
    "version": "0.0.1",
    "namespace": "default",
    "metadata": {
      "variables": {
        "schema": {
          "format": "json",
          "document": {
            "type": "object",
            "title": "Variables",
            "properties": {
              "opportunityRows": { "type": "array", "default": [] },
              "existingMap": { "type": "object", "default": {} }
            }
          }
        }
      }
    }
  },
  "input": {
    "schema": {
      "format": "json",
      "document": { "type": "object", "properties": {}, "title": "Inputs" }
    }
  },
  "output": {
    "schema": {
      "format": "json",
      "document": { "type": "object", "properties": {}, "title": "Outputs" }
    }
  },
  "do": [
    {
      "Sequence_1": {
        "do": [
          {
            "WorkflowStart": {
              "set": "${Object.entries($workflow.definition?.document?.metadata?.variables?.schema?.document?.properties || {}).reduce((acc, [name, def]) => ({ ...acc, [name]: def?.default }), {}) }",
              "output": { "as": "${$input}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Workflow start",
                "fullName": "Assign",
                "isTransparent": true
              }
            }
          },
          {
            "ListOpportunity_ClosedWon": {
              "call": "UiPath.IntSvc",
              "with": {
                "connector": "uipath-salesforce-sfdc",
                "connectionId": "322b8267-ffd6-4036-bd0a-d5557eebb5fa",
                "connectionResourceId": "322b8267-ffd6-4036-bd0a-d5557eebb5fa",
                "method": "GET",
                "endpoint": "/Opportunity",
                "queryParameters": {
                  "fields": "Id,Name,AccountId,StageName,CloseDate,Amount",
                  "pageSize": 2000,
                  "where": "StageName = 'Closed Won Booked'"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ListOpportunity_ClosedWon\": $output } }" },
              "metadata": {
                "fullName": "Connector",
                "activityType": "Connector",
                "displayName": "List Closed Won Opportunities",
                "uiPathActivityTypeId": "b98b6a53-4d89-3ad8-ad76-8fff9f27ce51",
                "assemblyQualifiedName": "Connector",
                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-salesforce-sfdc\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"list\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"Opportunity\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/Opportunity\",\"unifiedTypesCompatible\":true}}"
              }
            }
          },
          {
            "ParseOpportunityRows": {
              "run": {
                "script": {
                  "code": "const out = $context.outputs.ListOpportunity_ClosedWon; const raw = out && (out.content !== undefined ? out.content : out); const body = (typeof raw === 'string') ? JSON.parse(raw) : raw; const list = Array.isArray(body) ? body : ((body && (body.value || body.records)) || []); const nowIso = new Date().toISOString(); return list.map((r) => ({ opportunityId: r.Id, opportunityName: r.Name, customerId: r.AccountId, customerName: null, stageName: r.StageName, closeDate: r.CloseDate || null, amount: (r.Amount != null ? Number(r.Amount) : null), lastSyncedAt: nowIso })).filter((r) => !!r.opportunityId);",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ParseOpportunityRows\": $output } }" },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Parse Opportunity Rows",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Assign_SetOpportunityRows": {
              "set": { "opportunityRows": "${$context.outputs.ParseOpportunityRows}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Set Opportunity Rows",
                "fullName": "Assign",
                "isTransparent": false
              }
            }
          },
          {
            "ListOpportunityDirectory_1": {
              "call": "UiPath.IntSvc",
              "with": {
                "connector": "uipath-uipath-dataservice",
                "connectionId": "e6566513-4ace-47bb-9321-9b838bedef98",
                "connectionResourceId": "e6566513-4ace-47bb-9321-9b838bedef98",
                "method": "GET",
                "endpoint": "/CustomerOpportunityDirectory",
                "queryParameters": { "limit": 1000 }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"ListOpportunityDirectory_1\": $output } }" },
              "metadata": {
                "fullName": "Connector",
                "activityType": "Connector",
                "displayName": "List Opportunity Directory Records",
                "uiPathActivityTypeId": "b98b6a53-4d89-3ad8-ad76-8fff9f27ce51",
                "assemblyQualifiedName": "Connector",
                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"list\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CustomerOpportunityDirectory\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"GET\",\"path\":\"/CustomerOpportunityDirectory\",\"unifiedTypesCompatible\":true}}"
              }
            }
          },
          {
            "BuildExistingMap": {
              "run": {
                "script": {
                  "code": "const out = $context.outputs.ListOpportunityDirectory_1; const raw = out && (out.content !== undefined ? out.content : out); const body = (typeof raw === 'string') ? JSON.parse(raw) : raw; const list = Array.isArray(body) ? body : ((body && (body.value || body.items)) || []); const map = {}; list.forEach((rec) => { const oid = rec.opportunityId || rec.OpportunityId; const id = rec.Id || rec.id; if (oid) map[oid] = id; }); return map;",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"BuildExistingMap\": $output } }" },
              "metadata": {
                "activityType": "JsInvoke",
                "displayName": "Build Existing Map",
                "fullName": "JsInvoke"
              }
            }
          },
          {
            "Assign_SetExistingMap": {
              "set": { "existingMap": "${$context.outputs.BuildExistingMap}" },
              "export": { "as": "{ ...$context, variables: { ...$context.variables, ...$output } }" },
              "metadata": {
                "activityType": "Assign",
                "displayName": "Set Existing Map",
                "fullName": "Assign",
                "isTransparent": false
              }
            }
          },
          {
            "For_Each_1": {
              "for": {
                "each": "currentItem",
                "in": "${$context.variables.opportunityRows}",
                "at": "currentItemIndex"
              },
              "do": [
                {
                  "For_Each_1#Body": {
                    "do": [
                      {
                        "If_1#Wrapper": {
                          "do": [
                            {
                              "If_1": {
                                "switch": [
                                  {
                                    "case": {
                                      "when": "${$context.variables.existingMap[$currentItem.opportunityId] !== undefined}",
                                      "then": "If_1#Then"
                                    }
                                  },
                                  { "default": { "then": "If_1#Else" } }
                                ],
                                "metadata": { "displayName": "Existing record?" }
                              }
                            },
                            {
                              "If_1#Then": {
                                "do": [
                                  {
                                    "UpdateOpportunityDirectory_1": {
                                      "call": "UiPath.IntSvc",
                                      "with": {
                                        "connector": "uipath-uipath-dataservice",
                                        "connectionId": "e6566513-4ace-47bb-9321-9b838bedef98",
                                        "connectionResourceId": "e6566513-4ace-47bb-9321-9b838bedef98",
                                        "method": "PUT",
                                        "endpoint": "/CustomerOpportunityDirectory/{id}",
                                        "pathParameters": {
                                          "id": "${$context.variables.existingMap[$currentItem.opportunityId]}"
                                        },
                                        "bodyParameters": {
                                          "customerId": "${$currentItem.customerId}",
                                          "customerName": "${$currentItem.customerName}",
                                          "opportunityId": "${$currentItem.opportunityId}",
                                          "opportunityName": "${$currentItem.opportunityName}",
                                          "stageName": "${$currentItem.stageName}",
                                          "closeDate": "${$currentItem.closeDate}",
                                          "amount": "${$currentItem.amount}",
                                          "lastSyncedAt": "${$currentItem.lastSyncedAt}"
                                        }
                                      },
                                      "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"UpdateOpportunityDirectory_1\": $output } }" },
                                      "metadata": {
                                        "fullName": "Connector",
                                        "activityType": "Connector",
                                        "displayName": "Update Opportunity Directory Record",
                                        "uiPathActivityTypeId": "718fdc36-73a8-3607-8604-ddef95bb9967",
                                        "assemblyQualifiedName": "Connector",
                                        "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"replace\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CustomerOpportunityDirectory\",\"operation\":\"replace\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"PUT\",\"path\":\"/CustomerOpportunityDirectory/{id}\",\"unifiedTypesCompatible\":true}}"
                                      }
                                    }
                                  }
                                ],
                                "then": "exit"
                              }
                            },
                            {
                              "If_1#Else": {
                                "do": [
                                  {
                                    "CreateOpportunityDirectory_1": {
                                      "call": "UiPath.IntSvc",
                                      "with": {
                                        "connector": "uipath-uipath-dataservice",
                                        "connectionId": "e6566513-4ace-47bb-9321-9b838bedef98",
                                        "connectionResourceId": "e6566513-4ace-47bb-9321-9b838bedef98",
                                        "method": "POST",
                                        "endpoint": "/CustomerOpportunityDirectory",
                                        "bodyParameters": {
                                          "customerId": "${$currentItem.customerId}",
                                          "customerName": "${$currentItem.customerName}",
                                          "opportunityId": "${$currentItem.opportunityId}",
                                          "opportunityName": "${$currentItem.opportunityName}",
                                          "stageName": "${$currentItem.stageName}",
                                          "closeDate": "${$currentItem.closeDate}",
                                          "amount": "${$currentItem.amount}",
                                          "lastSyncedAt": "${$currentItem.lastSyncedAt}"
                                        }
                                      },
                                      "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"CreateOpportunityDirectory_1\": $output } }" },
                                      "metadata": {
                                        "fullName": "Connector",
                                        "activityType": "Connector",
                                        "displayName": "Create Opportunity Directory Record",
                                        "uiPathActivityTypeId": "dfd2bc7a-ca4b-3316-8a1f-57c9e106dfbf",
                                        "assemblyQualifiedName": "Connector",
                                        "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-dataservice\",\"activityType\":\"Generic\",\"objectName\":null,\"httpMethod\":null,\"operation\":\"create\",\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"CustomerOpportunityDirectory\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/CustomerOpportunityDirectory\",\"unifiedTypesCompatible\":true}}"
                                      }
                                    }
                                  }
                                ],
                                "then": "exit"
                              }
                            }
                          ],
                          "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"If_1\": $output } }" },
                          "metadata": {
                            "activityType": "If",
                            "displayName": "Existing record?",
                            "fullName": "If"
                          }
                        }
                      }
                    ],
                    "export": {
                      "as": "{ ...$context, outputs: { ...$context?.outputs, \"For_Each_1\": { ...$context?.outputs?.For_Each_1, results: [ ...($currentItemIndex == 0 ? [] : ($context?.outputs?.For_Each_1?.results ?? [])), ...([$output] ?? []) ] } } }"
                    }
                  }
                }
              ],
              "output": { "as": "${$context.outputs.For_Each_1}" },
              "metadata": {
                "activityType": "ForEach",
                "displayName": "Upsert Each Opportunity",
                "fullName": "ForEach"
              }
            }
          },
          {
            "Response_1": {
              "response": "${{ syncedOpportunities: $context.variables.opportunityRows.length, status: 'success' }}",
              "markJobAsFailed": false,
              "then": "end",
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"Response_1\": $output } }" },
              "metadata": {
                "activityType": "Response",
                "displayName": "Response",
                "fullName": "Response"
              }
            }
          }
        ],
        "metadata": {
          "activityType": "Sequence",
          "displayName": "Sequence",
          "fullName": "Sequence"
        }
      }
    }
  ],
  "evaluate": {
    "mode": "strict",
    "language": "javascript"
  }
}
