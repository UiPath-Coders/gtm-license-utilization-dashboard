                "script": {
                  "code": "const out = $context.outputs.report_1; const raw = out && (out.content !== undefined ? out.content : out); const body = (typeof raw === 'string') ? JSON.parse(raw) : raw; const cols = body.reportMetadata.detailColumns; const factKey = Object.keys(body.factMap)[0]; const rows = body.factMap[factKey].rows; const nowIso = new Date().toISOString(); const idx = {}; cols.forEach((c, i) => { idx[c] = i; }); const label = (cells, name) => { const i = idx[name]; if (i === undefined) return null; const cell = cells[i]; return cell ? cell.label : null; }; const val = (cells, name) => { const i = idx[name]; if (i === undefined) return null; const cell = cells[i]; return cell ? cell.value : null; }; const clean = (v) => (v === '-' || v === null || v === undefined) ? '' : v; return rows.map((r) => { const cells = r.dataCells; return { customerId: val(cells, 'ACCOUNT_ID') || label(cells, 'ACCOUNT_ID'), customerName: label(cells, 'ACCOUNT.NAME'), accountOwnerName: label(cells, 'USERS.NAME'), customerGeo: label(cells, 'Account.Geo__c'), customerArea: label(cells, 'Account.Area__c'), customerRegion: label(cells, 'Account.Region__c'), activeCustomer: (val(cells, 'Account.Active_Customer__c') === true || label(cells, 'Account.Active_Customer__c') === 'true'), csdName: clean(label(cells, 'Account.CSD__c')), tamName: clean(label(cells, 'Account.Support_Technical_Advisor__c')), customerSuccessManagerName: clean(label(cells, 'Account.CSM__c')), parentCompanyName: label(cells, 'PARENT.NAME'), activeFinancialArr: (val(cells, 'Account.Billed_ARR_YTD__c') != null ? Number(val(cells, 'Account.Billed_ARR_YTD__c')) : null), lastSyncedAt: nowIso }; });",
